<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: sin respaldo en la nube ni copia al cambiar de teléfono. La WebView guarda la sesión (JWT en
  localStorage) dentro de los datos de la app; si se copiara, se podría restaurar la sesión en otro equipo.
  Al cambiar de teléfono se vuelve a iniciar sesión.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
