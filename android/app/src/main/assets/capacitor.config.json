{
	"appId": "com.emnetwork.root",
	"appName": "root-electronic-network",
	"webDir": "native-shell",
	"server": {
		"url": "http://192.168.1.9:3000",
		"cleartext": true,
		"allowNavigation": [
			"*"
		]
	},
	"plugins": {
		"SystemBars": {
			"insetsHandling": "css",
			"initialViewportFitValueHint": "cover",
			"style": "DARK"
		},
		"PushNotifications": {
			"presentationOptions": [
				"sound",
				"alert"
			]
		},
		"GoogleSignIn": {
			"scopes": [
				"profile",
				"email"
			],
			"forceCodeForRefreshToken": true
		}
	}
}
