{
	"appId": "com.emnetwork.root",
	"appName": "Root",
	"backgroundColor": "#0A0B0D",
	"webDir": "native-shell",
	"server": {
		"url": "https://root-web-app.vercel.app",
		"cleartext": true,
		"allowNavigation": [
			"*"
		]
	},
	"plugins": {
		"SystemBars": {
			"insetsHandling": "css",
			"initialViewportFitValueHint": "cover",
			"style": "DARK"
		},
		"SplashScreen": {
			"launchAutoHide": true,
			"launchShowDuration": 6000,
			"launchFadeOutDuration": 200,
			"backgroundColor": "#0A0B0D",
			"showSpinner": false,
			"androidScaleType": "CENTER_CROP"
		},
		"PushNotifications": {
			"presentationOptions": [
				"sound",
				"alert"
			]
		},
		"GoogleSignIn": {
			"scopes": [
				"profile",
				"email"
			],
			"forceCodeForRefreshToken": true
		}
	}
}
