{
	"appId": "com.emnetwork.root",
	"appName": "Root",
	"backgroundColor": "#0A0B0D",
	"webDir": "native-shell",
	"ios": {
		"limitsNavigationsToAppBoundDomains": false
	},
	"server": {
		"url": "http://192.168.1.9:3000",
		"cleartext": true,
		"allowNavigation": [
			"*"
		],
		"errorPath": "error.html"
	},
	"plugins": {
		"SystemBars": {
			"insetsHandling": "css",
			"initialViewportFitValueHint": "cover",
			"style": "DARK"
		},
		"SplashScreen": {
			"launchAutoHide": true,
			"launchShowDuration": 6000,
			"launchFadeOutDuration": 200,
			"backgroundColor": "#0A0B0D",
			"showSpinner": false,
			"androidScaleType": "CENTER_CROP"
		},
		"PushNotifications": {
			"presentationOptions": [
				"sound",
				"alert"
			]
		},
		"GoogleSignIn": {
			"scopes": [
				"profile",
				"email"
			],
			"serverClientId": "964994558509-vbrduu76ftkdq80ms9f464ol3cujbgp3.apps.googleusercontent.com",
			"iosClientId": "964994558509-uve6a7u3l3cbon7s5inio497ajdm06j8.apps.googleusercontent.com",
			"forceCodeForRefreshToken": true
		}
	}
}
